{
  "name": "seed-plugin-packaging",
  "version": "1.5.0",
  "private": true,
  "description": "Validation and release packaging for the Seed MCP plugin",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/validate.mjs && node --test tests/*.test.mjs",
    "check:submission": "node scripts/validate.mjs --submission",
    "package": "node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
