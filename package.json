{
  "name": "seed-plugin-packaging",
  "version": "3.1.0",
  "private": true,
  "description": "Validation and release packaging for the authenticated SEED plugin",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/validate.mjs && node --test tests/*.test.mjs",
    "check:submission": "node scripts/validate.mjs --submission",
    "package": "node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:docs": "node scripts/smoke.mjs --docs-only",
    "probe:api-events": "node scripts/seed-api-events.mjs",
    "package:api": "node scripts/package.mjs --api"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
