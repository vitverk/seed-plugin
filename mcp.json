{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "seed_live": {
      "type": "streamable-http",
      "url": "https://mcp.flaxa.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://mcp.flaxa.app/mcp",
            "baseScopes": [
              "seed:profile:read",
              "seed:character-information:read",
              "seed:societies:read",
              "seed:wallet:read",
              "seed:staticdata:read",
              "seed:developer",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
