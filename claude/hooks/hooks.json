{
  "description": "Keeps ongoing SEED play from ending its turn with nothing due to wake it, and lets it wait for game events without holding the player's messages back.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Monitor|mcp__.*seed.*__wait_for_events",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/hooks/event-socket.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/hooks/keep-waiting.mjs\""
          }
        ]
      }
    ]
  }
}
