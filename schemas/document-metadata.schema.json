{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Searchable SEED document metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "description", "document_type", "source_type", "source_collection", "source_id", "source_url", "source_path", "source_version", "language", "category", "topics", "retrieved_at", "imported_at", "verification_status", "content_hash", "conflicts_with"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S"},
    "description": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"},
    "document_type": {"enum": ["article", "navigation", "manual", "concept", "workflow", "project", "index", "reference"]},
    "source_type": {"enum": ["help_center", "in_game_manual", "developer_reference", "local_api_reference", "project_reference", "collection_index", "derived"]},
    "source_collection": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "source_url": {"type": ["string", "null"], "pattern": "^https?://[^\\s]+$"},
    "source_path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "source_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "language": {"type": "string", "minLength": 2, "maxLength": 35},
    "category": {"type": "string", "maxLength": 240},
    "topics": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"}},
    "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
    "imported_at": {"type": ["string", "null"], "format": "date-time"},
    "verification_status": {"enum": ["source_snapshot", "unverified_reference", "derived"]},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "conflicts_with": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  }
}
